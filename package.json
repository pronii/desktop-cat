{
  "name": "desktop-cat",
  "version": "0.3.16",
  "description": "A tiny Electron desktop cat pet for Windows.",
  "main": "src/main/main.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "room:server": "node server/roomServer.js",
    "test": "node --test tests",
    "build:config": "node scripts/write-build-config.js",
    "pack": "npm run pack:release",
    "pack:portable": "npm run build:config && electron-builder --win portable",
    "pack:installer": "npm run build:config && electron-builder --win nsis",
    "pack:release": "npm run build:config && electron-builder --win nsis portable",
    "license:create": "node scripts/create-license-codes.js",
    "release:github": "node scripts/release-github.js"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "cat"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.desktopcat.app",
    "productName": "desktop-cat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "afterPack": "scripts/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "pronii",
        "repo": "desktop-cat"
      }
    ],
    "win": {
      "icon": "src/main/assets/tray-cat-face.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "desktop-cat"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9"
  }
}
